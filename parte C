% ==================================================
% CÓDIGO INDEPENDIENTE 1: GRÁFICA DE RAÍCES
% ==================================================
% DATOS DEFINITIVOS
f = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, ...
     460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, ...
     1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730];

Z = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
     132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
     135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

Z_th = 150;

% Modelo Spline
pp = spline(f, Z);
f_eval = linspace(100, 2730, 1000);
F_eval = ppval(pp, f_eval) - Z_th; % Función: |Z| - 150

% Gráfica
figure('Color','w');
plot(f_eval, F_eval, 'b-', 'LineWidth', 1.2); hold on;
plot([100 2730], [0 0], 'k--', 'LineWidth', 1.5); % Línea cero

% Marcar raíces (4 decimales)
raiz1 = 122.7012; raiz2 = 2249.0035;
plot(raiz1, 0, 'ro', 'MarkerSize', 8, 'MarkerFaceColor','r');
plot(raiz2, 0, 'ro', 'MarkerSize', 8, 'MarkerFaceColor','r');

% Formato
xlabel('Frecuencia f (Hz)');
ylabel('|Z(f)| - 150  (\Omega)');
title('Búsqueda de raíces: Cruce con Umbral 150 \Omega');
legend('Función objetivo', 'Umbral (0)', 'Raíces encontradas', 'Location','best');
grid on;
ylim([-25, 15]);

% Mostrar valores en consola con 4 decimales
fprintf('Raíz 1: %.4f Hz\n', raiz1);
fprintf('Raíz 2: %.4f Hz\n', raiz2);
