% =========================================================================
% MÉTODOS NUMÉRICOS: PARTE 2 - DERIVACIÓN NUMÉRICA CON TABLA AUTOMÁTICA
% =========================================================================
clear; clc;

% 1. Datos del ensayo de laboratorio
f = [10.0; 12.5; 15.0; 17.5; 20.0; 22.5; 25.0; 27.5; 30.0; 32.5; 35.0; 37.5; ...
     40.0; 42.5; 45.0; 47.5; 50.0; 52.5; 55.0; 57.5; 60.0; 62.5; 65.0; 67.5; ...
     70.0; 72.5; 75.0; 77.5; 80.0; 82.5; 85.0; 87.5; 90.0; 92.5; 95.0; 97.5; ...
     100.0; 102.5; 105.0; 107.5];

V = [0.842; 0.911; 0.986; 1.062; 1.143; 1.227; 1.314; 1.401; 1.482; 1.551; ...
     1.216; 1.048; 0.866; 0.689; 0.521; 0.364; 0.223; 0.103; 0.012; -0.041; ...
     -0.057; -0.034; 0.018; 0.096; 0.197; 0.318; 0.452; 0.579; 0.700; ...
     0.809; 0.611; 0.688; 0.756; 0.811; 0.856; 0.894; 0.926; 0.954; 0.980; 1.004];

h = 2.5; % Paso constante en kHz

%% 2. CÁLCULO DE DERIVADAS

% Puntos a evaluar (Se añade 10.0 para consolidar toda la parte 2)
f_eval = [10.0; 40.0; 70.0; 100.0];

% Inicializar vectores para almacenar resultados
res_C2     = NaN(4,1); % Centrada Orden 2
res_C4     = NaN(4,1); % Centrada Orden 4
res_Spline = zeros(4,1); % Derivada del Spline

% A. Obtención analítica de la derivada del Spline Cúbico
ppV = spline(f, V); 
[breaks, coefs, l, k, d] = unmkpp(ppV);
coefs_der = [3*coefs(:,1), 2*coefs(:,2), coefs(:,3)]; % Derivar coeficientes
ppV_der = mkpp(breaks, coefs_der, d);

% B. Evaluación punto por punto mediante Diferencias Finitas
for idx_eval = 1:length(f_eval)
    fe = f_eval(idx_eval);
    idx = find(f == fe); % Buscar el índice correspondiente en la tabla
    
    % Evaluar Spline siempre disponible
    res_Spline(idx_eval) = ppval(ppV_der, fe);
    
    % Fórmulas de diferencias finitas si existen los puntos vecinos necesarios
    if fe == 10.0
        % Extremo inferior: Fórmula Progresiva de Orden 2
        % Almacenada en la columna de C2 de forma especial para el extremo
        res_C2(idx_eval) = (-3*V(idx) + 4*V(idx+1) - V(idx+2)) / (2*h);
    else
        % Puntos intermedios: Esquema Centrado Orden 2
        res_C2(idx_eval) = (V(idx+1) - V(idx-1)) / (2*h);
        
        % Esquema Centrado Orden 4 (requiere i-2 e i+2)
        if idx > 2 && idx < length(f)-1
            res_C4(idx_eval) = (-V(idx+2) + 8*V(idx+1) - 8*V(idx-1) + V(idx-2)) / (12*h);
        end
    end
end

%% 3. CREACIÓN Y MUESTRA DE LA TABLA DE RESULTADOS EN CONSOLA
% Convertir los vectores a una tabla estructurada de MATLAB
Metodo_Extremo = {'Progresiva O(h^2)'; 'Centrada O(h^2)'; 'Centrada O(h^2)'; 'Centrada O(h^2)'};

Tabla_Resultados = table(f_eval, res_C2, res_C4, res_Spline, ...
    'VariableNames', {'Frecuencia_kHz', 'Diferencia_O_h2', 'Centrada_O_h4', 'Derivada_Spline'});

fprintf('\n=====================================================================\n');
fprintf('     TABLA DE RESULTADOS DE LA PARTE 2 (CON 4 DECIMALES EXACTOS)     \n');
fprintf('=====================================================================\n');
disp(Tabla_Resultados);
fprintf('Nota: El valor %.4f en la primera fila de Diferencia_O_h2 corresponde\n', res_C2(1));
fprintf('a la fórmula Progresiva O(h^2) por tratarse de un extremo.\n\n');

%% 4. GENERACIÓN DE GRÁFICO TÉCNICO
f_grid = linspace(min(f), max(f), 1000);
dVdf_spline_grid = ppval(ppV_der, f_grid);

figure('Name', 'Análisis de Sensibilidad dV/df', 'Color', [1 1 1]);
plot(f_grid, dVdf_spline_grid, 'b-', 'LineWidth', 2, 'DisplayName', 'Sensibilidad dV/df (Spline)');
hold on; grid on;
plot(f_eval(2:4), res_Spline(2:4), 'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 8, 'DisplayName', 'Puntos Centrados');
plot(10.0, res_Spline(1), 'go', 'MarkerFaceColor', 'g', 'MarkerSize', 8, 'DisplayName', 'Extremo 10.0 kHz');
yline(0, 'k--', 'LineWidth', 1.2, 'HandleVisibility', 'off');

title('Curva de Sensibilidad Dinámica del Front-End (dV / df)');
xlabel('Frecuencia de Excitación f (kHz)'); ylabel('Tasa de Cambio dV/df (V/kHz)');
legend('Location', 'best');
