% ==================================================
% CÓDIGO 4: MÉTODO NEWTON-RAPHSON - VERIFICADO
% ==================================================
% DATOS DEFINITIVOS
f = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, ...
     460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, ...
     1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730];
Z = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
     132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
     135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

pp = spline(f,Z);
fun = @(x) ppval(pp,x) - 150;
pp_der = fnder(pp,1);
dfun = @(x) ppval(pp_der,x);

% Algoritmo CORREGIDO
function r = newton(fun,dfun,x0,tol,max_iter)
 for k=1:max_iter
    xn = x0 - fun(x0)/dfun(x0);
    if abs(xn-x0) < tol
        break; 
    end
    x0 = xn;
 end
 r = xn;
end

% Parámetros
tol = 1e-6;
max_iter = 30;

% Cálculo y salida con 4 decimales
r1 = newton(fun,dfun,150,tol,max_iter);
r2 = newton(fun,dfun,2200,tol,max_iter);

fprintf('=== RESULTADOS NEWTON-RAPHSON ===\n');
fprintf('Raíz 1: %.4f Hz\n', r1);
fprintf('Raíz 2: %.4f Hz\n', r2);

% --- Cálculo de Sensibilidad ---
f0 = 2000;
dZdf = ppval(pp_der, f0);
dfdZ = 1 / dZdf;
DeltaZ = 0.1;
Deltaf = dfdZ * DeltaZ;

fprintf('\n=== SENSIBILIDAD en %.2f Hz ===\n', f0);
fprintf('dZ/df = %.4f Ω/Hz\n', dZdf);
fprintf('df/dZ = %.4f Hz/Ω\n', dfdZ);
fprintf('Δf (ante ΔZ = ±0.1 Ω) = ±%.4f Hz\n', Deltaf);
