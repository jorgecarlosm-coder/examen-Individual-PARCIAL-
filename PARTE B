% --------------------------
% Código: Interpolación Polinómica - Comparación de grados
% --------------------------
% DATOS DEFINITIVOS
f = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, ...
     460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, ...
     1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730];

Z = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
     132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
     135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

% Puntos para evaluación continua
f_eval = linspace(100, 2730, 1000);

% Grados a probar
grados = [5, 10, 12, 25]; 

figure('Color','w');
for k = 1:length(grados)
    n = grados(k);
    % Seleccionar puntos equidistantes para construir el polinomio
    idx = round(linspace(1, length(f), n+1));
    f_p = f(idx); 
    Z_p = Z(idx);
    
    % Construir matriz y calcular coeficientes
    V = fliplr(vander(f_p));  
    a = V \ Z_p';             
    
    % Evaluar polinomio
    P = polyval(flipud(a), f_eval);
    
    % Gráfico
    subplot(2,2,k);
    plot(f, Z, 'or', 'MarkerSize', 4); hold on;
    plot(f_eval, P, 'b-', 'LineWidth', 1);
    plot(730, 130.9, 'rp', 'MarkerSize', 8); % Marcar mínimo
    title(['Grado ', num2str(n)]);
    xlabel('f (Hz)'); 
    ylabel('|Z| (\Omega)');
    grid on;
    ylim([125, 165]); % Escala fija para comparar
end
sgtitle('Interpolación Polinómica: Efecto del grado');
